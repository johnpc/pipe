<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>PipeLogsAPIKey</key>
    <string>$(PIPE_LOGS_API_KEY)</string>
    <!-- App Transport Security: https everywhere, plain http only on the local
         network. A Piped instance is whatever the user types, so there is no
         fixed domain list to except; the one http case worth keeping is a
         self-hosted instance (or its media proxy) on the LAN: a .local name,
         an unqualified host name, or an IP address. A remote http:// instance
         is refused by iOS; PipedAPI turns that into "use its https address". -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Google Cast discovery: iOS requires a local-network usage prompt and
         the Bonjour service types the SDK browses (the default media receiver
         app id CC1AD845, plus the generic googlecast service). -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>pipe uses the local network to find and cast to TVs like Chromecast and Android TV.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_googlecast._tcp</string>
        <string>_CC1AD845._googlecast._tcp</string>
    </array>
</dict>
</plist>
