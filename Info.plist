<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>PipeLogsAPIKey</key>
    <string>$(PIPE_LOGS_API_KEY)</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Google Cast discovery: iOS requires a local-network usage prompt and
         the Bonjour service types the SDK browses (the default media receiver
         app id CC1AD845, plus the generic googlecast service). -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>pipe uses the local network to find and cast to TVs like Chromecast and Android TV.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_googlecast._tcp</string>
        <string>_CC1AD845._googlecast._tcp</string>
    </array>
</dict>
</plist>
