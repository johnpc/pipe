// Committed base build config. Defines a safe default for the diagnostics API
// key and optionally overlays the local, gitignored Secrets.xcconfig (present
// on dev machines, absent on CI). The `?` makes the include optional so a fresh
// checkout / CI build succeeds without the secret.
PIPE_LOGS_API_KEY =
#include? "Secrets.xcconfig"

// The Google Cast SDK ships as a *static* xcframework, so its system-library
// dependencies (which CocoaPods would inject via the podspec) must be linked
// explicitly here — otherwise the linker can't resolve symbols like
// SCNetworkReachability*. `$(inherited)` keeps any other flags intact.
OTHER_LDFLAGS = $(inherited) -ObjC -lc++ -framework SystemConfiguration -framework AVRouting -framework MediaAccessibility -framework MediaPlayer -framework Accelerate

// The "Copy Google Cast Resources" run-script phase copies the SDK's static
// resource bundles into the app. Xcode 15+ sandboxes script phases by default,
// which denies those file writes; disable sandboxing so the copy succeeds
// (locally and in CI).
ENABLE_USER_SCRIPT_SANDBOXING = NO
